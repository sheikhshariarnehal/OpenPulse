# Database Configuration
# PostgreSQL Relational Metadata Store (Prisma)
DATABASE_URL="postgresql://openpulse:openpulse_secret@localhost:5432/openpulse?schema=public"
POSTGRES_USER="openpulse"
POSTGRES_PASSWORD="openpulse_secret"
POSTGRES_DB="openpulse"

# ClickHouse High-Velocity Columnar Telemetry Store
CLICKHOUSE_HOST="http://localhost:8123"
CLICKHOUSE_DATABASE="openpulse"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# Next.js App Secret
NEXTAUTH_SECRET="openpulse_development_jwt_secret_32chars_min"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
